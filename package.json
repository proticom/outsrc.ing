{
  "name": "outsrc",
  "version": "0.2.0",
  "description": "Local MCP mailbox that lets any agent hand coding tasks to Claude Code, Codex and Grok Build in git worktrees.",
  "homepage": "https://outsrc.ing",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "grok",
    "agents",
    "worktree"
  ],
  "type": "module",
  "bin": {
    "outsrc-mcp": "dist/server.js",
    "outsrc": "dist/cli.js"
  },
  "files": [
    "dist",
    "engines.lock.json",
    "config.example.toml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "mcp": "node --import tsx src/server.ts",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --project tsconfig.tests.json",
    "smoke:native": "npm run build && node scripts/native-smoke.mjs",
    "smoke:plugins": "npm run build && node scripts/plugin-smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proticom/outsrc.ing.git"
  },
  "bugs": {
    "url": "https://github.com/proticom/outsrc.ing/issues"
  },
  "author": "Proticom"
}
